# MPMV web process (gunicorn) on a STAGE/LIVE host (ARC.5, ADR-0005).
# The image is the release selected by `mpmv-deploy`: it tags it localhost/mpmv-app:current.
[Unit]
Description=MPMV app (web)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mpmv-app
Image=localhost/mpmv-app:current
Pull=never
Exec=web
Network=mpmv.network
# Secrets and settings of this environment (DJANGO_SETTINGS_MODULE, keys, host names...), then
# the database connection (DATABASE_URL), kept apart because the database setup writes it.
# When both set a variable, the later file wins. See deploy/README.md.
EnvironmentFile=%h/.config/mpmv/mpmv.env
EnvironmentFile=%h/.config/mpmv/database.env
# Root certificate of the CA that signs the database server certificate (sslmode=verify-full,
# DATABASE_URL names it with sslrootcert=/etc/mpmv/pg-root-ca.crt).
Volume=%h/.config/mpmv/pg-root-ca.crt:/etc/mpmv/pg-root-ca.crt:ro,z
# Uploads and renditions (MEDIA_ROOT): a writable mount, never executable. The volume
# unit makes it owned by the image user.
Volume=mpmv-media.volume:/app/media:noexec,nosuid,nodev
# Anonymous page cache (SEO.6): shared by the app and the worker, never mounted in Caddy and never
# inside MEDIA_ROOT. Empty and unused while MPMV_PAGE_CACHE is off.
Volume=mpmv-pagecache.volume:/app/var/page-cache:noexec,nosuid,nodev
ReadOnly=true
NoNewPrivileges=true
DropCapability=ALL
HealthCmd=python -m mpmv.healthcheck
HealthInterval=30s
HealthRetries=3
HealthStartPeriod=20s
HealthTimeout=10s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
