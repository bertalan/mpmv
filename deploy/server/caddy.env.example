# Environment of the Caddy unit (ARC.5, ARC.13). Copy to ~/.config/mpmv/caddy.env on the server.
# Public host name of this environment, e.g. stage.example.org; nothing else (no scheme, port or
# IP). Caddy obtains its certificate from Let's Encrypt and serves the site only for this name.
MPMV_SITE_ADDRESS=
# "true" adds `X-Robots-Tag: noindex, nofollow` to every response: set it on STAGE, leave it
# empty on LIVE.
MPMV_NOINDEX=
# Networks that may reach the technical Django admin (/django-admin/), space separated addresses
# or CIDR networks (OPS.5). Everybody else gets the app's 404. Owner decision MQ-24: loopback only,
# no public network is ever listed; the owner reaches the admin through an SSH tunnel, see
# docs/dev/admin-access.md. Never leave the variable set but empty (Caddy counts that as set and
# fails to load); unset also means loopback only. The same list, comma separated, is in mpmv.env.
MPMV_ADMIN_ALLOWED_NETWORKS=127.0.0.1/32 ::1/128
