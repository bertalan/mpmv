# Environment of the Caddy unit (ARC.5, ARC.13). Copy to ~/.config/mpmv/caddy.env on the server.
# Public host name of this environment, e.g. stage.example.org; nothing else (no scheme, port or
# IP). Caddy obtains its certificate from Let's Encrypt and serves the site only for this name.
MPMV_SITE_ADDRESS=
# "true" adds `X-Robots-Tag: noindex, nofollow` to every response: set it on STAGE, leave it
# empty on LIVE.
MPMV_NOINDEX=
# Networks that may reach the technical Django admin (/django-admin/), space separated addresses
# or CIDR networks, e.g. 192.0.2.0/24 2001:db8::/32 (OPS.5). Everybody else gets 404. Empty: loopback
# only, so the admin is closed from outside. The same list, comma separated, goes in mpmv.env.
MPMV_ADMIN_ALLOWED_NETWORKS=
