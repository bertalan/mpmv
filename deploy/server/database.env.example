# Database connection of the app, worker and migrate units (ARC.13, ADR-0007). Copy to
# ~/.config/mpmv/database.env on the server and `chmod 600`; the database setup usually writes it.
# It is read after mpmv.env, so DATABASE_URL belongs here only.
# TLS with verify-full against the internal CA (owner decision MQ-11); the root certificate is
# mounted read-only at /etc/mpmv/pg-root-ca.crt from ~/.config/mpmv/pg-root-ca.crt:
#   postgres://<role>:<password>@<host>:5432/<database>?sslmode=verify-full&sslrootcert=/etc/mpmv/pg-root-ca.crt
DATABASE_URL=
