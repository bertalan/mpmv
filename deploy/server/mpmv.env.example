# Environment of the app, worker and migrate units on a STAGE/LIVE host (ARC.5).
# Copy to ~/.config/mpmv/mpmv.env on the server, `chmod 600`, and fill in the values there.
# Never commit real values; rotate them as described in spec 12 (SEC.5).
DJANGO_SETTINGS_MODULE=mpmv.settings.stage
DJANGO_SECRET_KEY=
# Field-level encryption keys (SEC.3, docs/dev/field-encryption.md): "<id>:<key>" entries,
# comma-separated, newest first; create one with `manage generate_field_key <id>`. Back them up
# apart from the database backups: without them the encrypted data (IBAN, tax codes) is lost.
# MPMV_FIELD_ENCRYPTION_KEYS_FILE (a path inside the container, one key per line) may be used
# instead, e.g. with a Podman secret; leave MPMV_FIELD_ENCRYPTION_KEYS empty then (both set
# stop the start-up).
MPMV_FIELD_ENCRYPTION_KEYS=
# Self-managed PostgreSQL 17 on a dedicated Hetzner VPS, reached over the private network
# with TLS (ADR-0007).
DATABASE_URL=
DJANGO_ALLOWED_HOSTS=
# Public base URL of the site, no trailing slash (CMS.1): links in Wagtail admin emails and
# previews. Required: `manage check --deploy` fails without it (cms.E001).
MPMV_BASE_URL=
# Gunicorn worker processes; about 2 x vCPU + 1, shared with the worker container.
WEB_CONCURRENCY=3
# Client IP behind Caddy (CORE.5): Caddy overwrites X-Real-IP (deploy/caddy/Caddyfile), and the
# app reads it only from the mpmv-net subnet (deploy/quadlet/mpmv.network). Without these, every
# client shares Caddy's address and the per-IP login lockout and registration limit hit the whole
# site; `manage check --deploy` warns about it (core.W001).
MPMV_TRUSTED_PROXY_HEADER=X-Real-IP
MPMV_TRUSTED_PROXIES=10.89.250.0/24
# Cloudflare Turnstile on login and registration forms (CORE.5). When true, both keys are
# required (the system check run by `migrate` fails without them); false disables the captcha.
MPMV_CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Feature flag defaults for this environment (ARC.8, docs/dev/feature-flags.md), e.g.
# "checkout=off". Empty: the code defaults (kill switches on). Staff switches in the admin
# override them; an unknown name fails the system check (core.E401).
MPMV_FEATURE_FLAGS=
# Server-side geocoding (EVT.12): the provider chain, the contact sent in Nominatim's
# User-Agent, and the optional LocationIQ and OpenCage keys (each provider is skipped without
# its key). Never commit a key.
MPMV_GEOCODING_PROVIDERS=nominatim,photon,locationiq,opencage
MPMV_GEOCODING_CONTACT=
MPMV_GEOCODING_LOCATIONIQ_KEY=
MPMV_GEOCODING_OPENCAGE_KEY=
# Theme of a Wagtail site that has no theme of its own (THM.1, docs/dev/themes.md). Empty means
# base; a name that is not a registered theme fails the system check (themes.E002).
MPMV_THEME_DEFAULT=
# Key-wide API rate limit of every key (CORE.16, owner decision MQ-4), "<calls>/<unit>". Empty
# means 120/minute. Staff raise or lower one key from the admin (audited, MFA step-up).
MPMV_API_RATE_LIMIT=
