# Environment of the app, worker and migrate units on a STAGE/LIVE host (ARC.5).
# Copy to ~/.config/mpmv/mpmv.env on the server, `chmod 600`, and fill in the values there.
# Never commit real values; rotate them as described in spec 12 (SEC.5).
DJANGO_SETTINGS_MODULE=mpmv.settings.stage
DJANGO_SECRET_KEY=
# Field-level encryption keys (SEC.3, docs/dev/field-encryption.md): "<id>:<key>" entries,
# comma-separated, newest first; create one with `manage generate_field_key <id>`. Back them up
# apart from the database backups: without them the encrypted data (IBAN, tax codes) is lost.
# MPMV_FIELD_ENCRYPTION_KEYS_FILE (a path inside the container, one key per line) may be used
# instead, e.g. with a Podman secret; leave MPMV_FIELD_ENCRYPTION_KEYS empty then (both set
# stop the start-up).
MPMV_FIELD_ENCRYPTION_KEYS=
# DATABASE_URL lives in database.env (database.env.example), read after this file.
DJANGO_ALLOWED_HOSTS=
# Public base URL of the site, no trailing slash (CMS.1): links in Wagtail admin emails and
# previews. Required: `manage check --deploy` fails without it (cms.E001).
MPMV_BASE_URL=
# Gunicorn worker processes; about 2 x vCPU + 1, shared with the worker container.
WEB_CONCURRENCY=3
# Client IP behind Caddy (CORE.5): Caddy overwrites X-Real-IP (deploy/caddy/Caddyfile), and the
# app reads it only from the mpmv-net subnet (deploy/quadlet/mpmv.network). Without these, every
# client shares Caddy's address and the per-IP login lockout and registration limit hit the whole
# site; `manage check --deploy` warns about it (core.W001).
MPMV_TRUSTED_PROXY_HEADER=X-Real-IP
MPMV_TRUSTED_PROXIES=10.89.250.0/24
# Networks that may reach the technical Django admin (/django-admin/), comma separated addresses or
# CIDR networks (OPS.5); everybody else gets 404. The same list, space separated, is in caddy.env.
# Empty or unset: the admin answers 404 to everybody (fail closed; `check --deploy` hints, core.W002).
# Owner decision MQ-24: loopback only, reached through an SSH tunnel (docs/dev/admin-access.md).
MPMV_ADMIN_ALLOWED_NETWORKS=127.0.0.1/32,::1/128
# Cloudflare Turnstile on login and registration forms (CORE.5). When true, both keys are
# required (the system check run by `migrate` fails without them); false disables the captcha.
MPMV_CAPTCHA_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Feature flag defaults for this environment (ARC.8, docs/dev/feature-flags.md), e.g.
# "checkout=off". Empty: the code defaults (kill switches on). Staff switches in the admin
# override them; an unknown name fails the system check (core.E401).
MPMV_FEATURE_FLAGS=
# Server-side geocoding (EVT.12): the provider chain, the contact sent in Nominatim's
# User-Agent, and the optional LocationIQ and OpenCage keys (each provider is skipped without
# its key). Never commit a key.
MPMV_GEOCODING_PROVIDERS=nominatim,photon,locationiq,opencage
MPMV_GEOCODING_CONTACT=
MPMV_GEOCODING_LOCATIONIQ_KEY=
MPMV_GEOCODING_OPENCAGE_KEY=
# Theme of a Wagtail site that has no theme of its own (THM.1, docs/dev/themes.md). Empty means
# base; a name that is not a registered theme fails the system check (themes.E002).
MPMV_THEME_DEFAULT=
# Key-wide API rate limit of every key (CORE.16, owner decision MQ-4), "<calls>/<unit>". Empty
# means 120/minute. Staff raise or lower one key from the admin (audited, MFA step-up).
MPMV_API_RATE_LIMIT=
# Refused API keys (401) per client IP (CORE.20): refused answers allowed in a rolling window,
# "<calls>/<unit>", empty means 30/minute; then the IP gets 429 for the block, in seconds,
# empty means 300.
MPMV_API_REFUSED_KEY_RATE_LIMIT=
MPMV_API_REFUSED_KEY_BLOCK_SECONDS=
# Demo seed (ARC.10, docs/dev/demo-seed.md): true lets `manage seed` run on STAGE; LIVE refuses
# it whatever this says (seed.E001).
MPMV_ALLOW_SEED=false
# Transactional email (ARC.16, docs/dev/transactional-email.md). Empty sender means the console
# backend, which LIVE refuses (core.E501) until the provider adapter of ARC.19 is named here.
MPMV_EMAIL_SENDER=
# Sender address of every email; empty means no-reply@localhost, which LIVE refuses (core.E502).
MPMV_EMAIL_FROM=
# Shared secret of the provider's bounce and complaint webhook; empty turns the webhook off.
# Never commit a value.
MPMV_EMAIL_WEBHOOK_SECRET=
# Parser of the provider's webhook payloads (dotted path); empty means the signed JSON stub.
MPMV_EMAIL_FEEDBACK_PARSER=
# Help or contact link in the header and footer of every public page (THM.3); empty hides it.
MPMV_HELP_URL=
# Map tiles (EVT.13): a Leaflet URL template on this site or one https host; empty means no tile
# layer. The attribution text and link default to OpenStreetMap's.
MPMV_MAP_TILE_URL=
MPMV_MAP_TILE_ATTRIBUTION=
MPMV_MAP_TILE_ATTRIBUTION_URL=
# VIES VAT number check endpoint (TAX.5); empty means the European Commission's REST API.
MPMV_VIES_API_URL=
# Image upload limits (SEC.2; mpmv/settings/base.py has the memory they cost per worker). Empty
# means the default in brackets. Bytes per file [26214400]; megapixels decoded for a still image,
# refused above [60000000]; for an animation, all frames together [16000000]; stored originals,
# downscaled above [40000000]; pixels a side [16000]; frames [300]; seconds a second upload waits
# for the process's image decoder before a "try again" error [30, at most 300]. core.E601/E602
# check them at startup; a value that is not a number stops the process when settings load.
MPMV_MAX_IMAGE_UPLOAD_BYTES=
MPMV_MAX_IMAGE_PIXELS=
MPMV_MAX_ANIMATION_PIXELS=
MPMV_MAX_STORED_IMAGE_PIXELS=
MPMV_MAX_IMAGE_SIDE=
MPMV_MAX_IMAGE_FRAMES=
MPMV_IMAGE_DECODE_WAIT_SECONDS=

# Observability (OPS.2, docs/dev/observability.md). Empty means the default in brackets.
# Log format: json [json] or plain. Error tracker adapter: none [none] or log (no external
# provider yet). Alert e-mail: empty uses the platform operator's support address; an alert
# repeats at most every [6] hours. `manage.py check_ops` (run by the host) reads the rest: a
# comma list of paths whose free space is checked, the minimum free percent [15], the WAL archive
# check (true or false [false]) and its allowed lag in seconds [900], and the file where the host
# writes the time of the last good backup (one ISO 8601 timestamp) with the allowed age in hours [26].
MPMV_LOG_FORMAT=
MPMV_ERROR_TRACKER=
MPMV_OPS_ALERT_EMAIL=
MPMV_OPS_ALERT_REPEAT_HOURS=
MPMV_OPS_DISK_PATHS=
MPMV_OPS_DISK_MIN_FREE_PERCENT=
MPMV_OPS_WAL_ARCHIVE_CHECK=
MPMV_OPS_WAL_MAX_LAG_SECONDS=
MPMV_OPS_BACKUP_STATUS_FILE=
MPMV_OPS_BACKUP_MAX_AGE_HOURS=
# SEO.8: true makes every page noindex (STAGE sets it itself); MPMV_DEMO_MODE=true implies it.
MPMV_FORCE_NOINDEX=false
MPMV_DEMO_MODE=false
# SEO.6: anonymous CMS pages from a file cache on the media volume (docs/dev/page-cache.md).
# Default off. 1 turns it on: enable after a STAGE soak. Seconds are the safety net for content
# without a signal; publishing drops the cache at once.
MPMV_PAGE_CACHE=0
MPMV_PAGE_CACHE_SECONDS=300
# Folder of the cache files; empty means MEDIA_ROOT/.page-cache (shared by app and worker).
MPMV_PAGE_CACHE_DIR=
