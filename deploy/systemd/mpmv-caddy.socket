# Listening sockets of the reverse proxy (OPS.5 follow-up). The systemd user instance opens them in
# the host's network namespace and passes them to mpmv-caddy.service (generated by Quadlet from
# deploy/quadlet/mpmv-caddy.container) by socket activation; Podman hands them on to Caddy. Caddy
# therefore sees the real client address of every connection, and a connection through an SSH
# tunnel to the host's loopback arrives from 127.0.0.1 (the OPS.5 admin allow-list relies on it).
#
# mpmv-deploy installs it into the systemd user unit directory (~/.config/systemd/user), not the
# Quadlet directory: it is a plain systemd unit. Binding 80 and 443 as a user needs
# `net.ipv4.ip_unprivileged_port_start=80`.
#
# The order of the Listen lines is the order of the file descriptors, and deploy/caddy/Caddyfile
# binds them by number. Change both files together (tests/unit/test_quadlets.py checks them):
#   fd 3  TCP 0.0.0.0:80   plain HTTP: redirect, ACME HTTP-01
#   fd 4  TCP [::]:80
#   fd 5  TCP 0.0.0.0:443  HTTPS, HTTP/1.1 and HTTP/2, ACME TLS-ALPN-01
#   fd 6  TCP [::]:443
#   fd 7  UDP 0.0.0.0:443  HTTPS, HTTP/3
#   fd 8  UDP [::]:443
# IPv4 and IPv6 have separate sockets (BindIPv6Only=ipv6-only), so an IPv4 client appears with its
# IPv4 address (127.0.0.1 through the tunnel), never as an IPv4-mapped IPv6 address.
[Unit]
Description=MPMV reverse proxy sockets (Caddy)

[Socket]
ListenStream=0.0.0.0:80
ListenStream=[::]:80
ListenStream=0.0.0.0:443
ListenStream=[::]:443
ListenDatagram=0.0.0.0:443
ListenDatagram=[::]:443
BindIPv6Only=ipv6-only

[Install]
WantedBy=sockets.target
