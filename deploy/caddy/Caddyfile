# Reverse proxy for a STAGE/LIVE host (ARC.5, ARC.13). Copy to ~/.config/mpmv/Caddyfile on the
# server. Settings come from ~/.config/mpmv/caddy.env (deploy/server/caddy.env.example):
#
# - MPMV_SITE_ADDRESS: the public host name, nothing else (no scheme, port or IP). Caddy obtains
#   and renews its certificate from Let's Encrypt (automatic HTTPS) and redirects HTTP to HTTPS.
# - MPMV_NOINDEX: "true" adds `X-Robots-Tag: noindex, nofollow` to every response (STAGE).
#   Off when empty or unset, as on LIVE.
#
# Only the configured host name gets the site. A request by IP address or for another host name
# gets no site: plain HTTP is dropped without an answer; HTTPS fails the TLS handshake (no
# certificate for that name), and a Host header that differs from the TLS server name gets 421.
# That 421 comes from strict_sni_host before any route runs, so the snippet below cannot reach it:
# it has an empty body but still carries `Server: Caddy` and none of the security headers. Caddy
# has no option to change it; the only thing it discloses is the proxy software.
#
# Caddy sets X-Forwarded-Proto, which Django trusts through SECURE_PROXY_SSL_HEADER
# (settings/live.py).
#
# Client IP (CORE.5): Caddy overwrites X-Real-IP with the client address, so a value sent by the
# client never reaches the app. Django reads it only from the mpmv-net subnet
# (MPMV_TRUSTED_PROXY_HEADER and MPMV_TRUSTED_PROXIES in mpmv.env). If a CDN proxies the site,
# {client_ip} is the CDN's address unless Caddy trusts it: add to the global options block
#   servers { trusted_proxies static <CDN ranges>
#             client_ip_headers CF-Connecting-IP }
# with the CDN's published ranges, and allow only those ranges to reach ports 80 and 443.
#
# Django admin (OPS.5): MPMV_ADMIN_ALLOWED_NETWORKS in caddy.env lists the networks (space
# separated CIDR or addresses) that may reach /django-admin/; the rest get 404.
#
# Security headers (SEC.3, SEC.5): Caddy answers some requests itself (public media, the /media/
# 404, its error pages, the HTTP-to-HTTPS redirect), so every site and handle_errors imports the
# `security_headers` snippet. Its headers are defaults (`?`): a value the app already sent is kept,
# so proxied responses are unchanged. The values must match the app's (settings/base.py,
# settings/live.py, apps.core.security); tests/unit/test_proxy_security_headers.py checks them.
# `-Server` drops Caddy's own `Server` header and gunicorn's, passed through reverse_proxy;
# `-Via` drops the `Via: 1.0 Caddy` that reverse_proxy adds.
{
	servers {
		strict_sni_host on
	}
}

(security_headers) {
	header {
		-Server
		-Via
		?Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		?X-Content-Type-Options "nosniff"
		?Referrer-Policy "strict-origin-when-cross-origin"
		?Cross-Origin-Opener-Policy "same-origin"
		?Cross-Origin-Resource-Policy "same-origin"
		?X-Frame-Options "DENY"
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		?Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
	}
}

{$MPMV_SITE_ADDRESS} {
	import security_headers

	# Request bodies (SEC.2): one image of up to 25 MiB (WAGTAILIMAGES_MAX_UPLOAD_SIZE) plus its
	# multipart form. A larger body gets 413 here instead of being spooled to disk by the app.
	request_body {
		max_size 26MiB
	}

	@noindex expression `{env.MPMV_NOINDEX} in ["1", "true", "yes", "on"]`
	header @noindex X-Robots-Tag "noindex, nofollow"

	encode zstd gzip

	# Public media: only image files in Wagtail's image folders (the THM.12 allow-list), straight
	# from the mpmv-media volume (read-only). Everything else under /media/ is a 404, so any private
	# upload never becomes public by path (private files belong in ARC.15's private storage); the
	# one exception is the `.pdf` documents below.
	# The files are inert: no listing, no MIME sniffing (the type comes from the allowed extension),
	# a sandbox CSP if one is opened directly (SEC.4). Originals and renditions are re-encoded by
	# the app, without metadata, under names it makes (SEC.2, apps/core/uploads.py).
	@public_media path_regexp public_media ^/media/(original_images|images)/[^/]+\.(?i:avif|webp|jpe?g|png|gif|svg)$
	handle @public_media {
		uri strip_prefix /media
		root * /srv/media
		header X-Content-Type-Options nosniff
		header Cache-Control "public, max-age=86400"
		# Sanitised SVG logos keep their inline styles (THM.12). The two matchers are exclusive on
		# purpose: the adapter runs a header with a matcher before one without, so an unmatched CSP
		# would overwrite the SVG one. Values, folders and extensions must match apps/core/media.py.
		@svg path_regexp svg (?i)\.svg$
		@not_svg not path_regexp (?i)\.svg$
		header @svg Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors 'none'; sandbox"
		header @not_svg Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		file_server
	}

	# Public documents (VEN.31): only `.pdf` files straight in `documents/`, which a vendor links
	# from a storefront text. A download, never rendered inline (Content-Disposition), not sniffed,
	# and a sandbox CSP if opened directly. The app accepts only checked PDFs, under names it makes
	# (apps/core/uploads.py `check_document`). Keep the pattern in sync with tests/upload_corpus.py.
	@public_documents path_regexp public_documents ^/media/documents/[^/]+\.(?i:pdf)$
	handle @public_documents {
		uri strip_prefix /media
		root * /srv/media
		header X-Content-Type-Options nosniff
		header Content-Type "application/pdf"
		header Content-Disposition "attachment"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; sandbox"
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle /media/* {
		respond 404
	}

	# The technical Django admin (OPS.5, owner decision Q-18): only from MPMV_ADMIN_ALLOWED_NETWORKS
	# (space separated; the app has its own comma separated copy, settings ADMIN_ALLOWED_NETWORKS).
	# Anybody else gets the app's own 404 for an unknown address (the request is rewritten to a
	# path that does not exist), so body and headers match any other 404. `client_ip` honours the
	# trusted proxies of the global options (a CDN in front); without them it is the connecting
	# address. Unset means loopback only, so a missing variable closes the admin. Caddy counts a
	# variable that is set but empty as set, and `not client_ip` with no argument fails to load:
	# leave the variable out of caddy.env instead of leaving it empty.
	@admin_denied {
		path /django-admin /django-admin/*
		not client_ip {$MPMV_ADMIN_ALLOWED_NETWORKS:127.0.0.1/32}
	}
	handle @admin_denied {
		rewrite * /__not-found__
		reverse_proxy mpmv-app:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	handle {
		reverse_proxy mpmv-app:8000 {
			header_up X-Real-IP {client_ip}
		}
	}

	# Caddy's own errors (502 when the app is down, 413 for an oversized body, the media 404s):
	# status only, no error text, with the security headers. Never cached: a 404 for an image
	# would otherwise keep the media handler's public Cache-Control, and a rendition fetched before
	# its file exists would stay missing in shared caches.
	handle_errors {
		import security_headers
		header Cache-Control "no-store"
		respond "{err.status_code}" {err.status_code}
	}
}

# The site's own host name over plain HTTP: redirect to HTTPS, with the security headers (Caddy's
# automatic redirect sends none). ACME HTTP challenges are still answered before this block.
http://{$MPMV_SITE_ADDRESS} {
	import security_headers
	# The configured host, not the client's Host spelling: the target is fixed by construction.
	redir https://{$MPMV_SITE_ADDRESS}{uri} 308
}

# Any other host name or a bare IP over plain HTTP: close the connection, serve nothing.
# The site's own host name has its own block above; ACME HTTP challenges are answered first.
http:// {
	abort
}
