#: apps/manager/lists.py
msgid "%(action)s: %(count)d row done."
msgid_plural "%(action)s: %(count)d rows done."
msgstr[0] "%(action)s: %(count)d riga completata."
msgstr[1] "%(action)s: %(count)d righe completate."

#: apps/accounts/templates/accounts/mfa/overview.html
msgid "%(counter)s unused."
msgid_plural "%(counter)s unused."
msgstr[0] "%(counter)s non usato."
msgstr[1] "%(counter)s non usati."

#: apps/accounts/mfa_views.py
msgid "%(name)s removed."
msgstr "%(name)s rimosso."

#: apps/orders/templates/email/orders/vendor_order_shipped/body.html
#: apps/orders/templates/email/orders/vendor_order_shipped/body.txt
msgid "%(vendor_name)s shipped its part of order %(order_number)s."
msgstr "%(vendor_name)s ha spedito la sua parte dell’ordine %(order_number)s."

#: apps/orders/templates/email/orders/vendor_order_cancelled/body.html
#: apps/orders/templates/email/orders/vendor_order_cancelled/body.txt
msgid "%(vendor_name)s's part of order %(order_number)s was cancelled."
msgstr "La parte dell’ordine %(order_number)s di %(vendor_name)s è stata annullata."

#: apps/orders/templates/email/orders/vendor_order_delivered/body.html
#: apps/orders/templates/email/orders/vendor_order_delivered/body.txt
msgid "%(vendor_name)s's part of order %(order_number)s was delivered."
msgstr "La parte dell’ordine %(order_number)s di %(vendor_name)s è stata consegnata."

#: apps/orders/templates/email/orders/vendor_new_order/body.html
#: apps/orders/templates/email/orders/vendor_new_order/body.txt
msgid "%(vendor_name)s: new paid order %(order_number)s to ship:"
msgstr "%(vendor_name)s: nuovo ordine pagato %(order_number)s da spedire:"

#: apps/orders/templates/email/orders/vendor_order_cancelled_notice/subject.txt
msgid "%(vendor_name)s: order %(order_number)s cancelled, do not ship"
msgstr "%(vendor_name)s: ordine %(order_number)s annullato, non spedire"

#: apps/catalog/taxonomy_admin.py
msgid "-- root --"
msgstr "-- radice --"

#: apps/cms/models.py
msgid "A category or tag that has its own pages."
msgstr "Una categoria o etichetta che ha pagine dedicate."

#: apps/cms/blocks.py apps/cms/models.py
msgid "A clear, short answer. It opens when the visitor clicks the question. Required."
msgstr ""
"Una risposta chiara e breve. Si apre quando il visitatore clicca sulla domanda. Obbligatoria."

#: apps/cms/models.py
msgid ""
"A few sentences about the author, shown on the author's page. If you leave it empty, the page "
"shows only the name."
msgstr ""
"Poche frasi sull'autore, mostrate nella sua pagina. Se lo lasci vuoto, la pagina mostra solo il "
"nome."

#: apps/catalog/models.py
msgid ""
"A few words about this version only, for example 'Matt finish, fits the large tray'. Optional."
msgstr ""
"Poche parole solo su questa versione, per esempio 'Finitura opaca, adatta al vassoio grande'. "
"Facoltativo."

#: apps/cms/models.py
msgid ""
"A few words shown at the top of the blog, above the list of articles. If you leave it empty, the "
"list starts right under the title."
msgstr ""
"Poche parole mostrate in cima al blog, sopra l'elenco degli articoli. Se lo lasci vuoto, l'elenco "
"parte subito sotto il titolo."

#: apps/events/models.py
msgid ""
"A few words shown at the top of the events list. If you leave it empty, the list starts right "
"under the title."
msgstr ""
"Poche parole mostrate in cima all'elenco degli eventi. Se lo lasci vuoto, l'elenco parte subito "
"sotto il titolo."

#: apps/vendors/models.py
msgid ""
"A fingerprint (SHA-256) of the exact text that was accepted, to prove later that it has not "
"changed."
msgstr ""
"Un'impronta (SHA-256) del testo esatto che è stato accettato, per dimostrare in seguito che non è "
"cambiato."

#: apps/catalog/taxonomy.py
msgid ""
"A list of https links to the same brand elsewhere: Wikipedia in each language, official profiles. "
"The Wikidata link is added from the ID above. Example: [\"https://en.wikipedia.org/wiki/Acme\"]."
msgstr ""
"Un elenco di link https allo stesso marchio altrove: Wikipedia in ogni lingua, profili ufficiali. "
"Il link a Wikidata viene aggiunto a partire dall'ID qui sopra. Esempio: "
"[\"https://it.wikipedia.org/wiki/Acme\"]."

#: apps/catalog/taxonomy.py
msgid ""
"A list of https links to the same company elsewhere: Wikidata, Wikipedia, official profiles. "
"Search engines use them to recognise the company. Example: [\"https://www.wikidata.org/wiki/Q7\"]."
msgstr ""
"Un elenco di link https alla stessa azienda altrove: Wikidata, Wikipedia, profili ufficiali. I "
"motori di ricerca li usano per riconoscere l'azienda. Esempio: "
"[\"https://www.wikidata.org/wiki/Q7\"]."

#: apps/manager/media.py
msgid ""
"A PDF document, for example your return policy. It is stored in your own shop collection and no "
"other shop can see it."
msgstr ""
"Un documento PDF, per esempio la tua politica di reso. Viene salvato nella raccolta del tuo "
"negozio e nessun altro negozio può vederlo."

#: apps/vendors/models.py
msgid ""
"A phone number where we can reach you, with the country prefix, for example +39 06 1234 5678. "
"Optional, up to 32 characters."
msgstr ""
"Un numero di telefono a cui possiamo chiamarti, con il prefisso internazionale, per esempio +39 06"
" 1234 5678. Facoltativo, al massimo 32 caratteri."

#: apps/cms/blocks.py
msgid "A picture for the banner. If you leave it empty, the banner has no picture."
msgstr "Un'immagine per il banner. Se la lasci vuota, il banner non ha immagine."

#: apps/cms/models.py
msgid ""
"A portrait of the author, shown on the author's page. If you leave it empty, no photo is shown."
msgstr ""
"Un ritratto dell'autore, mostrato nella sua pagina. Se lo lasci vuoto, non viene mostrata alcuna "
"foto."

#: apps/catalog/models.py
msgid ""
"A price in euros without VAT for this version only, for example 24.00. Leave it empty and the "
"version costs the same as the product."
msgstr ""
"Un prezzo in euro, IVA esclusa, solo per questa versione, per esempio 24,00. Se lo lasci vuoto, la"
" versione costa come il prodotto."

#: apps/catalog/models.py
msgid "A private reminder of why the rule exists, up to 200 characters. Visitors never see it."
msgstr ""
"Un promemoria privato sul perché esiste la regola, fino a 200 caratteri. I visitatori non lo "
"vedono mai."

#: apps/cms/models.py
msgid ""
"A question a new seller would ask, for example 'How much does it cost?'. Required: the question "
"cannot be saved without it."
msgstr ""
"Una domanda che farebbe un nuovo venditore, per esempio 'Quanto costa?'. Obbligatoria: senza non "
"si può salvare la domanda."

#: apps/cms/blocks.py
msgid ""
"A sentence or two about the launch, up to 400 characters. If you leave it empty, only the title "
"and the clock are shown."
msgstr ""
"Una o due frasi sul lancio, fino a 400 caratteri. Se lo lasci vuoto, si vedono solo il titolo e il"
" conto alla rovescia."

#: apps/cms/blocks.py
msgid ""
"A sentence or two that says why to click, up to 400 characters. If you leave it empty, only the "
"title and the button are shown."
msgstr ""
"Una o due frasi che spiegano perché cliccare, fino a 400 caratteri. Se lo lasci vuoto, si vedono "
"solo il titolo e il pulsante."

#: apps/catalog/attributes.py
msgid ""
"A short fixed name for this attribute, for example 'size'. Required: lower case letters, digits "
"and _, starting with a letter. Imports use it, so do not change it later; buyers never see it."
msgstr ""
"Un nome breve e fisso per questo attributo, per esempio 'taglia'. Obbligatorio: lettere minuscole,"
" cifre e _, a partire da una lettera. Le importazioni lo usano, quindi non cambiarlo dopo; chi "
"compra non lo vede mai."

#: apps/catalog/taxonomy.py
msgid ""
"A short fixed name for this set of categories or tags, for example 'season'. Required: lower case "
"letters, digits and _, starting with a letter. Imports use it, so do not change it later; buyers "
"never see it."
msgstr ""
"Un nome breve e fisso per questo gruppo di categorie o etichette, per esempio 'stagione'. "
"Obbligatorio: lettere minuscole, cifre e _, a partire da una lettera. Le importazioni lo usano, "
"quindi non cambiarlo dopo; chi compra non lo vede mai."

#: apps/catalog/attributes.py
msgid ""
"A short fixed name for this value, for example 'red'. Required: lower case letters, digits, "
"hyphens or _. Imports use it, so do not change it later; buyers never see it."
msgstr ""
"Un nome breve e fisso per questo valore, per esempio 'rosso'. Obbligatorio: lettere minuscole, "
"cifre, trattini o _. Le importazioni lo usano, quindi non cambiarlo dopo; chi compra non lo vede "
"mai."

#: apps/catalog/taxonomy.py
msgid ""
"A short label of the import run. It tells reviewers where the brands come from. Example: 'spring "
"price list, import of 2026-11-02'."
msgstr ""
"Un'etichetta breve dell'importazione. Dice ai revisori da dove arrivano i marchi. Esempio: "
"'listino di primavera, importazione del 02/11/2026'."

#: apps/cms/models.py
msgid ""
"A short line shown under the main picture, up to 250 characters. If you leave it empty, no caption"
" is shown."
msgstr ""
"Una breve riga mostrata sotto l'immagine principale, fino a 250 caratteri. Se la lasci vuota, non "
"viene mostrata alcuna didascalia."

#: apps/cms/blocks.py
msgid ""
"A short line shown under the picture, up to 250 characters. If you leave it empty, no caption is "
"shown."
msgstr ""
"Una breve riga mostrata sotto l'immagine, fino a 250 caratteri. Se la lasci vuota, non viene "
"mostrata alcuna didascalia."

#: apps/cms/blocks.py
msgid ""
"A short line under the title, up to 250 characters. If you leave it empty, the card uses the short"
" text of what it points to, if any."
msgstr ""
"Una breve riga sotto il titolo, fino a 250 caratteri. Se la lasci vuota, la scheda usa il testo "
"breve di ciò a cui rimanda, se c'è."

#: apps/vendors/models.py
msgid ""
"A short line under your shop name, up to 200 characters, for example 'Handmade ceramics from "
"Umbria'. Leave it empty to show none."
msgstr ""
"Una breve frase sotto il nome del negozio, al massimo 200 caratteri, per esempio 'Ceramiche fatte "
"a mano in Umbria'. Lasciala vuota se non ne vuoi una."

#: apps/catalog/models.py
msgid ""
"A short teaser of one or two sentences, for example 'Hand-made ceramic mug, 300 ml'. Optional: you"
" can leave it empty."
msgstr ""
"Un breve riassunto di una o due frasi, per esempio 'Tazza in ceramica fatta a mano, 300 ml'. "
"Facoltativo: puoi lasciarlo vuoto."

#: apps/cms/models.py
msgid ""
"A short teaser shown in the blog list, up to 300 characters. If you leave it empty, the list shows"
" no teaser."
msgstr ""
"Un breve riassunto mostrato nell'elenco del blog, fino a 300 caratteri. Se lo lasci vuoto, "
"l'elenco non mostra alcun riassunto."

#: apps/cms/models.py
msgid ""
"A short text shown above the products of this category or tag. If you add none, the page starts "
"with its products."
msgstr ""
"Un breve testo mostrato sopra i prodotti di questa categoria o etichetta. Se non ne aggiungi, la "
"pagina parte direttamente dai prodotti."

#: apps/cms/blocks.py
msgid ""
"A title above the cards, for example 'You may also like'. If you leave it empty, the cards have no"
" title."
msgstr ""
"Un titolo sopra le schede, per esempio 'Potrebbe piacerti anche'. Se lo lasci vuoto, le schede non"
" hanno titolo."

#: apps/cms/blocks.py
msgid ""
"A title above the products, up to 120 characters. If you leave it empty, the title is the name of "
"the chosen category, tag, brand or shop."
msgstr ""
"Un titolo sopra i prodotti, fino a 120 caratteri. Se lo lasci vuoto, il titolo è il nome della "
"categoria, dell'etichetta, della marca o del negozio scelti."

#: apps/cms/blocks.py
msgid ""
"A title above the questions, for example 'Questions and answers'. If you leave it empty, the "
"questions have no title."
msgstr ""
"Un titolo sopra le domande, per esempio 'Domande e risposte'. Se lo lasci vuoto, le domande non "
"hanno titolo."

#: apps/cms/blocks.py
msgid ""
"A title shown above the products, for example 'Our favourites'. Up to 120 characters. If you leave"
" it empty, no title is shown."
msgstr ""
"Un titolo mostrato sopra i prodotti, per esempio 'I nostri preferiti'. Fino a 120 caratteri. Se lo"
" lasci vuoto, non viene mostrato nessun titolo."

#: apps/events/admin_views.py apps/events/models.py
msgid "A vendor's first events up to this number go through review."
msgstr ""
"I primi eventi di un venditore, fino a questo numero, vengono controllati prima di andare online. "
"Esempio: 3. Obbligatorio."

#: apps/manager/forms.py
msgid "About the shop"
msgstr "Informazioni sul negozio"

#: apps/manager/templates/manager/shop/order.html
msgid "Accept the order"
msgstr "Accetta l'ordine"

