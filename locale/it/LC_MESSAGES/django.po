#: apps/manager/lists.py
msgid "%(action)s: %(count)d row done."
msgid_plural "%(action)s: %(count)d rows done."
msgstr[0] "%(action)s: %(count)d riga completata."
msgstr[1] "%(action)s: %(count)d righe completate."

#: apps/accounts/templates/accounts/mfa/overview.html
msgid "%(counter)s unused."
msgid_plural "%(counter)s unused."
msgstr[0] "%(counter)s non usato."
msgstr[1] "%(counter)s non usati."

#: apps/accounts/mfa_views.py
msgid "%(name)s removed."
msgstr "%(name)s rimosso."

#: apps/orders/templates/email/orders/vendor_order_shipped/body.html
#: apps/orders/templates/email/orders/vendor_order_shipped/body.txt
msgid "%(vendor_name)s shipped its part of order %(order_number)s."
msgstr "%(vendor_name)s ha spedito la sua parte dell’ordine %(order_number)s."

#: apps/orders/templates/email/orders/vendor_new_order/body.html
#: apps/orders/templates/email/orders/vendor_new_order/body.txt
msgid "%(vendor_name)s: new paid order %(order_number)s to ship:"
msgstr "%(vendor_name)s: nuovo ordine pagato %(order_number)s da spedire:"

#: apps/cms/blocks.py apps/cms/models.py
msgid ""
"A clear, short answer. It opens when the visitor clicks the question. "
"Required."
msgstr ""
"Una risposta chiara e breve. Si apre quando il visitatore clicca sulla "
"domanda. Obbligatoria."

#: apps/cms/models.py
msgid ""
"A few sentences about the author, shown on the author's page. If you leave "
"it empty, the page shows only the name."
msgstr ""
"Poche frasi sull'autore, mostrate nella sua pagina. Se lo lasci vuoto, la "
"pagina mostra solo il nome."

#: apps/cms/models.py
msgid ""
"A few words shown at the top of the blog, above the list of articles. If you"
" leave it empty, the list starts right under the title."
msgstr ""
"Poche parole mostrate in cima al blog, sopra l'elenco degli articoli. Se lo "
"lasci vuoto, l'elenco parte subito sotto il titolo."

#: apps/events/models.py
msgid ""
"A few words shown at the top of the events list. If you leave it empty, the "
"list starts right under the title."
msgstr ""
"Poche parole mostrate in cima all'elenco degli eventi. Se lo lasci vuoto, "
"l'elenco parte subito sotto il titolo."

#: apps/cms/blocks.py
msgid ""
"A picture for the banner. If you leave it empty, the banner has no picture."
msgstr ""
"Un'immagine per il banner. Se la lasci vuota, il banner non ha immagine."

#: apps/cms/models.py
msgid ""
"A portrait of the author, shown on the author's page. If you leave it empty,"
" no photo is shown."
msgstr ""
"Un ritratto dell'autore, mostrato nella sua pagina. Se lo lasci vuoto, non "
"viene mostrata alcuna foto."

#: apps/cms/models.py
msgid ""
"A question a new seller would ask, for example 'How much does it cost?'. "
"Required: the question cannot be saved without it."
msgstr ""
"Una domanda che farebbe un nuovo venditore, per esempio 'Quanto costa?'. "
"Obbligatoria: senza non si può salvare la domanda."

#: apps/cms/blocks.py
msgid ""
"A sentence or two about the launch, up to 400 characters. If you leave it "
"empty, only the title and the clock are shown."
msgstr ""
"Una o due frasi sul lancio, fino a 400 caratteri. Se lo lasci vuoto, si "
"vedono solo il titolo e il conto alla rovescia."

#: apps/cms/blocks.py
msgid ""
"A sentence or two that says why to click, up to 400 characters. If you leave"
" it empty, only the title and the button are shown."
msgstr ""
"Una o due frasi che spiegano perché cliccare, fino a 400 caratteri. Se lo "
"lasci vuoto, si vedono solo il titolo e il pulsante."

#: apps/cms/models.py
msgid ""
"A short line shown under the main picture, up to 250 characters. If you "
"leave it empty, no caption is shown."
msgstr ""
"Una breve riga mostrata sotto l'immagine principale, fino a 250 caratteri. "
"Se la lasci vuota, non viene mostrata alcuna didascalia."

#: apps/cms/blocks.py
msgid ""
"A short line shown under the picture, up to 250 characters. If you leave it "
"empty, no caption is shown."
msgstr ""
"Una breve riga mostrata sotto l'immagine, fino a 250 caratteri. Se la lasci "
"vuota, non viene mostrata alcuna didascalia."

#: apps/cms/blocks.py
msgid ""
"A short line under the title, up to 250 characters. If you leave it empty, "
"the card uses the short text of what it points to, if any."
msgstr ""
"Una breve riga sotto il titolo, fino a 250 caratteri. Se la lasci vuota, la "
"scheda usa il testo breve di ciò a cui rimanda, se c'è."

#: apps/cms/models.py
msgid ""
"A short teaser shown in the blog list, up to 300 characters. If you leave it"
" empty, the list shows no teaser."
msgstr ""
"Un breve riassunto mostrato nell'elenco del blog, fino a 300 caratteri. Se "
"lo lasci vuoto, l'elenco non mostra alcun riassunto."

#: apps/cms/models.py
msgid ""
"A short text shown above the products of this term. If you add none, the "
"term page starts with its products."
msgstr ""
"Un breve testo mostrato sopra i prodotti di questa etichetta. Se non ne "
"aggiungi, la pagina parte direttamente dai prodotti."

#: apps/cms/models.py
msgid "A term of a taxonomy with term pages."
msgstr ""
"Un'etichetta di una classificazione che ha pagine dedicate alle etichette."

#: apps/cms/blocks.py
msgid ""
"A title above the cards, for example 'You may also like'. If you leave it "
"empty, the cards have no title."
msgstr ""
"Un titolo sopra le schede, per esempio 'Potrebbe piacerti anche'. Se lo "
"lasci vuoto, le schede non hanno titolo."

#: apps/cms/blocks.py
msgid ""
"A title above the products, up to 120 characters. If you leave it empty, the"
" title is the name of the chosen category, tag, brand or shop."
msgstr ""
"Un titolo sopra i prodotti, fino a 120 caratteri. Se lo lasci vuoto, il "
"titolo è il nome della categoria, dell'etichetta, della marca o del negozio "
"scelti."

#: apps/cms/blocks.py
msgid ""
"A title above the questions, for example 'Questions and answers'. If you "
"leave it empty, the questions have no title."
msgstr ""
"Un titolo sopra le domande, per esempio 'Domande e risposte'. Se lo lasci "
"vuoto, le domande non hanno titolo."

#: apps/events/admin_views.py apps/events/models.py
msgid "A vendor's first events up to this number go through review."
msgstr ""
"I primi eventi di un venditore, fino a questo numero, vengono controllati "
"prima di andare online. Esempio: 3. Obbligatorio."

