#: apps/accounts/templates/accounts/mfa/recovery_codes_new.html
msgid "Continue"
msgstr "Continua"

#: apps/accounts/templates/accounts/action_link/continue.html
msgid "Continue does not sign you in: the page it opens asks you to confirm who you are."
msgstr "Continua non ti fa accedere: la pagina che si apre ti chiede di confermare la tua identità."

#: apps/accounts/templates/accounts/action_link/continue.html
msgid "Continue to your request"
msgstr "Continua con la tua richiesta"

#: apps/catalog/taxonomy.py
msgid "country"
msgstr "paese"

#: apps/manager/templates/manager/shop/order.html
msgid "Customer"
msgstr "Cliente"

#: apps/manager/forms.py
msgid "Customers see this text. A change is live at once and the moderators are told."
msgstr ""
"I clienti vedono questo testo. Una modifica è visibile subito e i moderatori vengono avvisati."

#: apps/manager/sections.py apps/manager/templates/manager/platform/dashboard.html
#: apps/manager/templates/manager/shop/dashboard.html
msgid "Dashboard"
msgstr "Dashboard"

#: apps/shipping/models.py
msgid "Days added to the method's estimated delivery time in this area."
msgstr "Giorni aggiunti al tempo di consegna stimato del metodo in quest'area."

#: apps/manager/templates/manager/platform/notice_detail.html
msgid "Decided"
msgstr "Deciso"

#: apps/accounts/admin.py
msgid "Delete selected %(verbose_name_plural)s"
msgstr "Elimina %(verbose_name_plural)s selezionati"

#: apps/catalog/taxonomy.py
msgid "description"
msgstr "descrizione"

#: apps/manager/forms.py
msgid "Description of the logo"
msgstr "Descrizione del logo"

#: themes/base/templates/components/alert.html
msgid "Dismiss"
msgstr "Chiudi"

#: apps/manager/templates/manager/shop/dashboard.html
msgid "Drafts"
msgstr "Bozze"

#: apps/accounts/templates/accounts/mfa/_recovery_codes_list.html
msgid ""
"Each code signs you in once if you lose your authenticator or passkey. Store them somewhere safe "
"now: they are shown only this time."
msgstr ""
"Ogni codice ti fa accedere una sola volta se perdi l’app di autenticazione o la passkey. "
"Conservali subito in un luogo sicuro: vengono mostrati solo questa volta."

#: apps/manager/templates/manager/login.html
msgid "Email"
msgstr "Email"

#: apps/accounts/admin.py
msgid ""
"Enabled: you set a password now. Disabled: the account is created without a password and cannot "
"sign in with a password until one is set."
msgstr ""
"Abilitata: imposti subito una password. Disabilitata: l'account viene creato senza password e non "
"può accedere con una password finché non ne viene impostata una."

#: apps/manager/forms.py
msgid "Enter a valid carrier name."
msgstr "Inserisci un nome di corriere valido."

#: apps/manager/media.py
msgid "Enter a valid web address starting with https://"
msgstr "Inserisci un indirizzo web valido che inizi con https://"

#: apps/manager/forms.py
msgid "Enter the tracking number: letters, digits, spaces and . / _ - only."
msgstr "Inserisci il numero di tracciamento: solo lettere, cifre, spazi e . / _ -"

#: themes/base/templates/components/alert.html
msgid "Error"
msgstr "Errore"

#: apps/manager/templates/manager/platform/notice_detail.html
msgid "Exact location"
