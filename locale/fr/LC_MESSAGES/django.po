msgid ""
"This order has a change in progress, started by %(who)s (last edited %(since)s). Only that side "
"may change, apply or discard it."
msgstr ""
"Cette commande a une modification en cours, commencée par %(who)s (dernière modification "
"%(since)s). Seule cette partie peut la modifier, l’appliquer ou l’abandonner."

#: apps/orders/templates/orders/_payment_status.html
msgid "This order is no longer open for payment."
msgstr "Cette commande n'est plus ouverte au paiement."

#: apps/manager/amendment_views.py
msgid "This order is not paid yet, so it cannot be changed here."
msgstr "Cette commande n’est pas encore payée, elle ne peut donc pas être modifiée ici."

#: apps/orders/amendments.py
msgid "This order is not paid yet: change it through the checkout or the quote instead."
msgstr "Cette commande n'est pas encore payée : modifiez-la plutôt via le paiement ou le devis."

#: apps/orders/staff_drafts.py
msgid "This order's customer data is no longer kept."
msgstr "Les données client de cette commande ne sont plus conservées."

#: apps/orders/amendments.py
msgid ""
"This package already has an open amendment (%(ref)s, %(state)s): finish, withdraw or discard it "
"before drafting another."
msgstr ""
"Ce colis a déjà une modification ouverte (%(ref)s, %(state)s) : terminez-la, retirez-la ou "
"abandonnez-la avant d'en rédiger une autre."

#: apps/orders/amendments.py
msgid ""
"This package already has an open amendment: finish, withdraw or discard it before drafting "
"another."
msgstr ""
"Ce colis a déjà une modification ouverte : terminez-la, retirez-la ou abandonnez-la avant d'en "
"rédiger une autre."

#: apps/manager/views.py
msgid ""
"This package cannot be shipped before %(when)s: an item was removed as unavailable and the "
"customer may still cancel the rest of it."
msgstr ""
"Ce colis ne peut pas être expédié avant le %(when)s : un article a été supprimé car indisponible "
"et le client peut encore en annuler le reste."

#: apps/manager/views.py
msgid ""
"This package has a change in progress: apply or discard it before marking the package shipped."
msgstr ""
"Ce colis a une modification en cours : appliquez-la ou abandonnez-la avant de marquer le colis "
"comme expédié."

#: apps/orders/amendments.py
msgid "This package has already shipped or is closed, so the rest of it can no longer be cancelled."
msgstr "Ce colis a déjà été expédié ou est clos, son reste ne peut donc plus être annulé."

#: apps/orders/amendments.py
msgid ""
"This package is %(state)s: an order can be amended only before shipping, while the package is "
"pending or accepted."
msgstr ""
"Ce colis est %(state)s : une commande ne peut être modifiée qu'avant l'expédition, tant que le "
"colis est en attente ou accepté."

#: apps/catalog/templates/catalog/listing.html apps/catalog/templates/catalog/product.html
