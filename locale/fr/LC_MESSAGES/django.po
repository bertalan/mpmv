msgid ""
"The seller %(vendor_name)s no longer has %(items)s in stock, while the other items in your order "
"%(order_number)s are ready for dispatch."
msgstr ""
"Le vendeur %(vendor_name)s ne dispose plus en stock de %(items)s, tandis que les autres articles "
"de ta commande %(order_number)s sont prêts pour l’expédition."

