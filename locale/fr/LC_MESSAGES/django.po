#: apps/vendors/templates/email/vendors/profile_changed/body.html
#: apps/vendors/templates/email/vendors/profile_changed/body.txt
msgid ""
"%(vendor_name)s changed its storefront profile (%(language)s): %(fields)s. The change is already "
"live. Review it in the audit log; staff can revert it."
msgstr ""
"%(vendor_name)s a modifié son profil de vitrine (%(language)s) : %(fields)s. La modification est "
"déjà en ligne. Vérifiez-la dans le journal d'audit ; l'équipe peut la rétablir."

#: apps/orders/templates/email/orders/amendment_applied/body.html
#: apps/orders/templates/email/orders/amendment_applied/body.txt
msgid "%(vendor_name)s changed your order %(order_number)s before shipping it:"
msgstr "%(vendor_name)s a modifié ta commande %(order_number)s avant de l’expédier :"

#: apps/vendors/templates/email/vendors/claim_link/body.html
#: apps/vendors/templates/email/vendors/claim_link/body.txt
msgid ""
"%(vendor_name)s has been set up on the platform for you. To claim it, open this link, confirm the "
"VAT number or TIN of the business, and create your account with a password and an authenticator "
"app."
msgstr ""
"%(vendor_name)s a été créé pour vous sur la plateforme. Pour le revendiquer, ouvrez ce lien, "
"confirmez le numéro de TVA ou l'identifiant fiscal de l'entreprise et créez votre compte avec un "
"mot de passe et une application d'authentification."

#: apps/orders/templates/email/orders/vendor_order_shipped/body.html
#: apps/orders/templates/email/orders/vendor_order_shipped/body.txt
msgid "%(vendor_name)s shipped its part of order %(order_number)s."
msgstr "%(vendor_name)s a expédié sa partie de la commande %(order_number)s."

#: apps/orders/templates/email/orders/vendor_order_cancelled/body.html
#: apps/orders/templates/email/orders/vendor_order_cancelled/body.txt
msgid "%(vendor_name)s's part of order %(order_number)s was cancelled."
msgstr "La partie de la commande %(order_number)s de %(vendor_name)s a été annulée."

#: apps/orders/templates/email/orders/vendor_order_delivered/body.html
#: apps/orders/templates/email/orders/vendor_order_delivered/body.txt
msgid "%(vendor_name)s's part of order %(order_number)s was delivered."
msgstr "La partie de la commande %(order_number)s de %(vendor_name)s a été livrée."

#: apps/orders/templates/email/orders/vendor_new_order/body.html
#: apps/orders/templates/email/orders/vendor_new_order/body.txt
msgid "%(vendor_name)s: new paid order %(order_number)s to ship:"
msgstr "%(vendor_name)s : nouvelle commande payée %(order_number)s à expédier :"

#: apps/orders/templates/email/orders/vendor_order_cancelled_notice/subject.txt
#: apps/orders/templates/email/orders/vendor_package_cancelled/subject.txt
msgid "%(vendor_name)s: order %(order_number)s cancelled, do not ship"
msgstr "%(vendor_name)s : commande %(order_number)s annulée, ne pas expédier"

#: apps/orders/templates/email/orders/vendor_amendment_applied/subject.txt
msgid "%(vendor_name)s: order %(order_number)s changed (version %(version)s)"
msgstr "%(vendor_name)s : commande %(order_number)s modifiée (version %(version)s)"

#: apps/orders/templates/email/orders/vendor_amendment_applied/subject.txt
msgid "%(vendor_name)s: platform support changed order %(order_number)s"
msgstr "%(vendor_name)s : le support de la plateforme a modifié la commande %(order_number)s"

#: apps/compliance/templates/email/compliance/withdrawal_vendor_notice/body.html
#: apps/compliance/templates/email/compliance/withdrawal_vendor_notice/body.txt
msgid ""
"%(vendor_name)s: the buyer of order %(order_number)s declared on %(submitted_at)s that they "
"withdraw from the contract for your part of the order (reference %(reference)s)."
msgstr ""
"%(vendor_name)s : l'acheteur de la commande %(order_number)s a déclaré le %(submitted_at)s qu'il "
"exerce son droit de rétractation pour votre partie de la commande (référence %(reference)s)."

#: apps/catalog/templates/email/catalog/brand_rejected/body.html
#: apps/catalog/templates/email/catalog/brand_rejected/body.txt
msgid ""
"%(vendor_name)s: the platform team did not approve the brand below. It was removed from your "
"products listed under it, which stay on sale without a brand. Open each product in your shop area "
"and pick an existing brand, or propose the brand again with an official link or a Wikidata ID."
msgstr ""
"%(vendor_name)s : l'équipe de la plateforme n'a pas approuvé la marque ci-dessous. Elle a été "
"retirée de vos produits listés sous cette marque, qui restent en vente sans marque. Ouvrez chaque "
"produit dans votre espace boutique et choisissez une marque existante, ou proposez à nouveau la "
"marque avec un lien officiel ou un identifiant Wikidata."

#: apps/core/models.py
msgid ""
"'Default' follows the setting of this environment, or the default of the code if there is none. "
"'On' and 'Off' switch the feature on or off."
msgstr ""
"'Par défaut' suit le réglage de cet environnement, ou la valeur par défaut du code s'il n'y en a "
"pas. 'Activé' et 'Désactivé' activent ou désactivent la fonction."

#: apps/core/translation_fields.py
msgid ""
"'Machine draft' was made automatically and needs a person to check it. 'Reviewed' was checked by a"
" person. 'Published' is shown to visitors. If the English text changes, reviewed and published "
"translations go back to 'Machine draft'."
msgstr ""
"'Brouillon automatique' a été créé automatiquement et doit être vérifié par une personne. 'Relu' a"
" été vérifié par une personne. 'Publié' est affiché aux visiteurs. Si le texte anglais change, les"
" traductions relues et publiées repassent à 'Brouillon automatique'."

