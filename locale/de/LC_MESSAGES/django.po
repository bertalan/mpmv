#: apps/orders/templates/email/orders/vendor_order_cancelled/body.txt
#: apps/orders/templates/email/orders/vendor_order_delivered/body.html
#: apps/orders/templates/email/orders/vendor_order_delivered/body.txt
#: apps/orders/templates/email/orders/vendor_order_shipped/body.html
#: apps/orders/templates/email/orders/vendor_order_shipped/body.txt
msgid "Hello,"
msgstr "Hallo,"

#: apps/orders/templates/email/orders/vendor_new_order/subject.txt
msgid "New paid order %(order_number)s"
msgstr "Neue bezahlte Bestellung %(order_number)s"

#: apps/orders/templates/email/orders/order_cancelled/subject.txt
msgid "Order %(order_number)s was cancelled"
msgstr "Bestellung %(order_number)s wurde storniert"

#: apps/orders/templates/email/orders/order_cancelled/body.html
#: apps/orders/templates/email/orders/order_cancelled/body.txt
msgid ""
"Order %(order_number)s was cancelled before payment. Nothing was charged."
msgstr ""
"Die Bestellung %(order_number)s wurde vor der Zahlung storniert. Es wurde "
"nichts abgebucht."

#: apps/orders/templates/email/orders/vendor_order_cancelled_notice/body.html
#: apps/orders/templates/email/orders/vendor_order_cancelled_notice/body.txt
msgid "Order %(order_number)s was cancelled. Do not ship these items:"
msgstr ""
"Die Bestellung %(order_number)s wurde storniert. Bitte versende diese "
"Artikel nicht:"

#: apps/orders/templates/email/orders/order_confirmation/body.html
#: apps/orders/templates/email/orders/order_confirmation/body.txt
msgid "Order %(order_number)s, sold by %(vendor_name)s:"
msgstr "Bestellung %(order_number)s, verkauft von %(vendor_name)s:"

#: apps/orders/templates/email/orders/vendor_order_shipped/subject.txt
msgid "Order %(order_number)s: a shipment is on its way"
msgstr "Bestellung %(order_number)s: Eine Sendung ist unterwegs"

#: apps/orders/templates/email/orders/vendor_order_delivered/subject.txt
msgid "Order %(order_number)s: a shipment was delivered"
msgstr "Bestellung %(order_number)s: Eine Sendung wurde zugestellt"

#: apps/orders/templates/email/orders/order_confirmation/subject.txt
msgid "Order %(order_number)s: confirmation from %(vendor_name)s"
msgstr "Bestellung %(order_number)s: Bestätigung von %(vendor_name)s"

#: apps/orders/templates/email/orders/vendor_order_cancelled/subject.txt
msgid "Order %(order_number)s: part of your order was cancelled"
msgstr ""
"Bestellung %(order_number)s: Ein Teil deiner Bestellung wurde storniert"

#: apps/orders/templates/email/orders/payment_confirmed/subject.txt
msgid "Payment received for order %(order_number)s"
msgstr "Zahlung für Bestellung %(order_number)s erhalten"

#: apps/orders/templates/email/orders/vendor_new_order/body.html
#: apps/orders/templates/email/orders/vendor_new_order/body.txt
msgid "Ship to:"
msgstr "Versand an:"

#: apps/orders/templates/email/orders/order_confirmation/body.html
#: apps/orders/templates/email/orders/order_confirmation/body.txt
msgid "Shipping: %(shipping)s EUR"
msgstr "Versand: %(shipping)s EUR"

#: apps/orders/templates/email/orders/order_confirmation/body.html
#: apps/orders/templates/email/orders/order_confirmation/body.txt
msgid "Total: %(total)s EUR"
msgstr "Gesamtsumme: %(total)s EUR"

#: apps/orders/templates/email/orders/order_received/subject.txt
msgid "We received your order %(order_number)s"
msgstr "Wir haben deine Bestellung %(order_number)s erhalten"

#: apps/orders/templates/email/orders/order_received/body.html
#: apps/orders/templates/email/orders/order_received/body.txt
msgid ""
"We received your order %(order_number)s (total %(total)s EUR). We will "
"confirm it when the payment is complete."
msgstr ""
"Wir haben deine Bestellung %(order_number)s erhalten (Gesamtsumme %(total)s "
"EUR). Wir bestätigen sie, sobald die Zahlung abgeschlossen ist."

#: apps/orders/templates/email/orders/payment_confirmed/body.html
#: apps/orders/templates/email/orders/payment_confirmed/body.txt
msgid ""
"We received your payment of %(total)s EUR for order %(order_number)s. Each "
"seller will prepare its part and you will get a message when it ships."
msgstr ""
"Wir haben deine Zahlung von %(total)s EUR für die Bestellung "
"%(order_number)s erhalten. Jeder Verkäufer bereitet seinen Teil vor, und du "
"bekommst eine Nachricht, sobald er versandt wird."
