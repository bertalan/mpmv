msgid "Order %(order_number)s: a shipment is on its way"
msgstr "Pedido %(order_number)s: un envío está en camino"

#: apps/orders/templates/email/orders/vendor_order_delivered/subject.txt
msgid "Order %(order_number)s: a shipment was delivered"
msgstr "Pedido %(order_number)s: un envío ha sido entregado"

#: apps/orders/templates/email/orders/order_confirmation/subject.txt
msgid "Order %(order_number)s: confirmation from %(vendor_name)s"
msgstr "Pedido %(order_number)s: confirmación de %(vendor_name)s"

#: apps/orders/templates/email/orders/vendor_order_cancelled/subject.txt
msgid "Order %(order_number)s: part of your order was cancelled"
msgstr "Pedido %(order_number)s: una parte de tu pedido se ha cancelado"

#: apps/orders/templates/email/orders/payment_confirmed/subject.txt
msgid "Payment received for order %(order_number)s"
msgstr "Pago recibido del pedido %(order_number)s"

#: apps/orders/templates/email/orders/vendor_new_order/body.html
#: apps/orders/templates/email/orders/vendor_new_order/body.txt
msgid "Ship to:"
msgstr "Enviar a:"

#: apps/orders/templates/email/orders/order_confirmation/body.html
#: apps/orders/templates/email/orders/order_confirmation/body.txt
msgid "Shipping: %(shipping)s EUR"
msgstr "Envío: %(shipping)s EUR"

#: apps/orders/templates/email/orders/order_confirmation/body.html
#: apps/orders/templates/email/orders/order_confirmation/body.txt
msgid "Total: %(total)s EUR"
msgstr "Total: %(total)s EUR"

#: apps/orders/templates/email/orders/order_received/subject.txt
msgid "We received your order %(order_number)s"
msgstr "Hemos recibido tu pedido %(order_number)s"

#: apps/orders/templates/email/orders/order_received/body.html
#: apps/orders/templates/email/orders/order_received/body.txt
msgid ""
"We received your order %(order_number)s (total %(total)s EUR). We will "
"confirm it when the payment is complete."
msgstr ""
"Hemos recibido tu pedido %(order_number)s (total %(total)s EUR). Te lo "
"confirmaremos cuando se complete el pago."

#: apps/orders/templates/email/orders/payment_confirmed/body.html
#: apps/orders/templates/email/orders/payment_confirmed/body.txt
msgid ""
"We received your payment of %(total)s EUR for order %(order_number)s. Each "
"seller will prepare its part and you will get a message when it ships."
msgstr ""
"Hemos recibido tu pago de %(total)s EUR del pedido %(order_number)s. Cada "
"vendedor preparará su parte y recibirás un mensaje cuando se envíe."
