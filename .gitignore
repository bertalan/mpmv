# --- OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp

# --- Secrets: never commit real env files (templates end in .example)
.env
.env.*
!.env.example
*.pem
*.key

# --- Python
__pycache__/
*.py[cod]
.venv/
.python-version.local
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Django / Wagtail runtime
/media/
/staticfiles/
*.sqlite3
*.log

# --- Frontend tooling
node_modules/

# --- Generated output (rebuild with `make docs`)
/build/
/dist/

# --- Local data dumps and imports (legacy exports must never land in git)
/var/
*.sql
*.sql.gz
*.dump

# --- Claude Code local settings
.claude/settings.local.json

# --- Private notes: unredacted spec, vendor map, legacy security findings (never publish)
/private/

# --- Local agent notes with machine paths (Claude Code convention)
CLAUDE.local.md
