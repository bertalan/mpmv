# Copy to .env for local overrides. Never commit real values.
DJANGO_SETTINGS_MODULE=mpmv.settings.dev
DJANGO_SECRET_KEY=change-me
# Optional in dev (falls back to the secret key); required on STAGE and LIVE.
MPMV_PRIVACY_PEPPER=
DATABASE_URL=postgres://mpmv@127.0.0.1:55432/mpmv
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Business time zone (ARC.27): UTC when unset; the platform runs in Europe/Rome. Any known zone
# works: the order triggers read the operator's zone too (ORD.41).
MPMV_BUSINESS_TIME_ZONE=Europe/Rome

# Breached-password check (CORE.28): outbound HTTPS to api.pwnedpasswords.com, fail open when down.
# MPMV_BREACH_CHECK_ENABLED=true
# MPMV_BREACH_CHECK_URL=https://api.pwnedpasswords.com/range/
