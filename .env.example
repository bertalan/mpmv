# Copy to .env for local overrides. Never commit real values.
DJANGO_SETTINGS_MODULE=mpmv.settings.dev
DJANGO_SECRET_KEY=change-me
# Optional in dev (falls back to the secret key); required on STAGE and LIVE.
MPMV_PRIVACY_PEPPER=
DATABASE_URL=postgres://mpmv@127.0.0.1:55432/mpmv
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
